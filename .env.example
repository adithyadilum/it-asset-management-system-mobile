# Backend API URL.
#
# HTTPS is required in release builds — the pairing exchange returns a 30-day
# administrative token that is sent on every subsequent request, so plaintext
# transport would expose it to anyone on the same network. Android (API 28+)
# and iOS ATS block cleartext in release builds regardless.
#
# For device testing against a local server, an HTTPS tunnel is preferred:
#   npx ngrok http 3000
EXPO_PUBLIC_API_URL=https://your-server.example.com

# Plaintext HTTP is accepted in development builds only, and only for loopback
# or private-LAN addresses. Do not use `localhost` from a physical device.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Pusher WebSocket client keys
EXPO_PUBLIC_PUSHER_KEY=your_pusher_key_here
EXPO_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster_here
