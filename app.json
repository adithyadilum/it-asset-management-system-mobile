{
  "expo": {
    "name": "TIQRI Assets",
    "slug": "it-asset-management-system-mobile",
    "version": "1.0.0",
    "scheme": "tiqri-assets",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tiqri.eitams.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tiqri.eitams.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EITAMS uses the camera to scan asset QR codes and hardware barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8bedc1e-9e8d-4878-b316-608adf182bce"
      }
    },
    "owner": "adithya-dilum"
  }
}
